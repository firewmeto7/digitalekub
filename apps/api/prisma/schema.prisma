generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROVIDER
}

enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum LotteryStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum LotStatus {
  AVAILABLE
  ASSIGNED
  PAID
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

enum ResultStatus {
  DRAFT
  ANNOUNCED
  CORRECTED
}

enum ProofType {
  IMAGE
  DOCUMENT
  VIDEO
  TEXT
  OTHER
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String         @map("password_hash")
  fullName          String         @map("full_name")
  role              UserRole
  provider          Provider?
  verifiedPayments  Payment[]      @relation("PaymentVerifier")
  announcedResults  Result[]       @relation("ResultAnnouncer")
  notifications     Notification[]
  adminLogs         AdminLog[]
  resolvedDisputes  Dispute[]      @relation("DisputeResolver")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model Provider {
  id               String                  @id @default(cuid())
  userId           String                  @unique @map("user_id")
  displayName      String                  @map("display_name")
  phone            String
  status           ProviderStatus          @default(PENDING)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccounts  ProviderPaymentAccount[]
  lotteries        Lottery[]
  reviews          Review[]
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@map("providers")
}

model ProviderPaymentAccount {
  id            String   @id @default(cuid())
  providerId    String   @map("provider_id")
  accountName   String   @map("account_name")
  institution   String
  accountNumber String   @map("account_number")
  phoneNumber   String?  @map("phone_number")
  isPrimary     Boolean  @default(false) @map("is_primary")
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("provider_payment_accounts")
}

model Lottery {
  id            String        @id @default(cuid())
  providerId    String        @map("provider_id")
  title         String
  description   String?
  size          Int
  ticketPrice   Decimal       @db.Decimal(12, 2) @map("ticket_price")
  currency      String        @default("ETB")
  status        LotteryStatus @default(DRAFT)
  startsAt      DateTime?     @map("starts_at")
  endsAt        DateTime?     @map("ends_at")
  provider      Provider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  lots          Lot[]
  payments      Payment[]
  result        Result?
  payouts       Payout[]
  notifications Notification[]
  disputes      Dispute[]
  reviews       Review[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("lotteries")
}

model Lot {
  id            String   @id @default(cuid())
  lotteryId     String   @map("lottery_id")
  lotNumber     Int      @map("lot_number")
  playerId      String?  @map("player_id")
  status        LotStatus @default(AVAILABLE)
  lottery       Lottery  @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  player        Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  payments      Payment[]
  winningResult Result?  @relation("WinningLot")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([lotteryId, lotNumber])
  @@map("lots")
}

model Player {
  id             String         @id @default(cuid())
  phone          String
  nickname       String
  lots           Lot[]
  payments       Payment[]
  winningResults Result[]       @relation("WinningPlayer")
  payouts        Payout[]
  notifications  Notification[]
  disputes       Dispute[]
  reviews        Review[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@unique([phone, nickname])
  @@map("players")
}

model Payment {
  id           String        @id @default(cuid())
  lotteryId    String        @map("lottery_id")
  lotId        String?       @map("lot_id")
  playerId     String        @map("player_id")
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("ETB")
  reference    String?
  evidenceUrl  String?       @map("evidence_url")
  status       PaymentStatus @default(PENDING)
  verifiedById String?       @map("verified_by_id")
  verifiedAt   DateTime?     @map("verified_at")
  lottery      Lottery       @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  lot          Lot?          @relation(fields: [lotId], references: [id], onDelete: SetNull)
  player       Player        @relation(fields: [playerId], references: [id], onDelete: Restrict)
  verifiedBy   User?         @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

model Result {
  id              String       @id @default(cuid())
  lotteryId       String       @unique @map("lottery_id")
  winnerLotId     String?      @unique @map("winner_lot_id")
  winnerLotNumber Int?         @map("winner_lot_number")
  winnerPlayerId  String?      @map("winner_player_id")
  proofUrl        String?      @map("proof_url")
  proofType       ProofType?   @map("proof_type")
  notes           String?
  announcedById   String?      @map("announced_by")
  announcedAt     DateTime?    @map("announced_at")
  status          ResultStatus @default(DRAFT)
  lottery         Lottery      @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  winnerLot       Lot?         @relation("WinningLot", fields: [winnerLotId], references: [id], onDelete: SetNull)
  winnerPlayer    Player?      @relation("WinningPlayer", fields: [winnerPlayerId], references: [id], onDelete: SetNull)
  announcedBy     User?        @relation("ResultAnnouncer", fields: [announcedById], references: [id], onDelete: SetNull)
  payouts         Payout[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("results")
}

model Payout {
  id        String       @id @default(cuid())
  lotteryId String       @map("lottery_id")
  resultId  String       @map("result_id")
  playerId  String       @map("player_id")
  amount    Decimal      @db.Decimal(12, 2)
  currency  String       @default("ETB")
  status    PayoutStatus @default(PENDING)
  paidAt    DateTime?    @map("paid_at")
  notes     String?
  lottery   Lottery      @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  result    Result       @relation(fields: [resultId], references: [id], onDelete: Cascade)
  player    Player       @relation(fields: [playerId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("payouts")
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?             @map("user_id")
  playerId  String?             @map("player_id")
  lotteryId String?             @map("lottery_id")
  channel   NotificationChannel @default(IN_APP)
  status    NotificationStatus  @default(PENDING)
  title     String
  body      String
  sentAt    DateTime?           @map("sent_at")
  readAt    DateTime?           @map("read_at")
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  player    Player?             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  lottery   Lottery?            @relation(fields: [lotteryId], references: [id], onDelete: SetNull)
  createdAt DateTime            @default(now()) @map("created_at")

  @@map("notifications")
}

model Dispute {
  id           String        @id @default(cuid())
  lotteryId    String        @map("lottery_id")
  playerId     String        @map("player_id")
  subject      String
  description  String
  status       DisputeStatus @default(OPEN)
  resolvedById String?       @map("resolved_by_id")
  resolution   String?
  resolvedAt   DateTime?     @map("resolved_at")
  lottery      Lottery       @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  player       Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  resolvedBy   User?         @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("disputes")
}

model Review {
  id         String   @id @default(cuid())
  providerId String   @map("provider_id")
  playerId   String   @map("player_id")
  lotteryId  String   @map("lottery_id")
  rating     Int
  comment    String?
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  lottery    Lottery  @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([providerId, playerId, lotteryId])
  @@map("reviews")
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String   @map("admin_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_logs")
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}